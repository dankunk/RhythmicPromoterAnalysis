gene_field<- intersect(c("GENEID","gene_id"), tx_cols)[1]
stopifnot(!is.na(tx_field), !is.na(gene_field))
tx_map <- select(
rpadi_txdb,
keys     = keys(rpadi_txdb, keytype = tx_field),
keytype  = tx_field,
columns  = c(tx_field, gene_field)
) %>%
distinct()
tx_map <- dplyr::select(
rpadi_txdb,
keys     = keys(rpadi_txdb, keytype = tx_field),
keytype  = tx_field,
columns  = c(tx_field, gene_field)
) %>%
