columns  = c(tx_field, gene_field)
) %>%
distinct()
# Coerce and normalize to LOC-style gene IDs if needed
tx_map <- tx_map %>%
mutate(
!!gene_field := as.character(.data[[gene_field]]),
loc_id = ifelse(grepl("^LOC", .data[[gene_field]]),
.data[[gene_field]],
paste0("LOC", .data[[gene_field]]))
) %>%
transmute(geneName = .data[[tx_field]], gene_id = loc_id)
# --- 2) Helper to write promoters from a df with 'geneName' ---
write_promoters_for <- function(df, out_fasta) {
ids <- df %>%
left_join(tx_map, by = "geneName") %>%
pull(gene_id) %>%
unique() %>%
na.omit() %>%
intersect(names(rpadi_upseqs))
writeXStringSet(rpadi_upseqs[ids], out_fasta)
}
