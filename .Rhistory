# general helper: percent of promoters with >= k unique E-box sites
pct_promoters_kplus <- function(hist_counts, total_promoters, k = 1) {
n_kplus <- hist_counts %>%
filter(n_sites >= k) %>%
group_by(cond, model) %>%
summarise(n_prom_kplus = sum(freq), .groups = "drop")
total_promoters %>%
left_join(n_kplus, by = c("cond", "model")) %>%
mutate(
n_prom_kplus = replace_na(n_prom_kplus, 0L),
n_prom_zero  = total_prom - n_prom_kplus,
pct_kplus    = 100 * n_prom_kplus / total_prom
) %>%
arrange(cond, as.integer(model))
}
# % promoters with at least one E-box
